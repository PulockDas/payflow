# --- Database (used by docker-compose.yml and, later, by the Spring app) ---
DB_NAME=payflow
DB_USER=payflow
DB_PASSWORD=change-me

STRIPE_SECRET_KEY=sk_test_
# The real webhook secret comes from `stripe listen` (M5)
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Optional: defaults to http://localhost:8080
APP_BASE_URL=http://localhost:8080

# Secret for admin endpoints (refunds). Use a long random value.
ADMIN_API_TOKEN=change-me-to-a-long-random-value
